# Bot User OAuth Token (starts with xoxb-)
# Slack app > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing Secret — Slack app > Basic Information > Signing Secret
# Required in HTTP mode (Events API); optional in Socket Mode.
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-Level Token (starts with xapp-) — Socket Mode only, great for local development
# Slack app > Basic Information > App-Level Tokens (scope: connections:write)
# Leave commented out to run in HTTP mode instead.
# SLACK_APP_TOKEN=xapp-your-app-token-here

# Port used in HTTP mode
PORT=3000
